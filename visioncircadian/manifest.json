
{
  "manifest_version": 3,
  "name": "VisionCircadian",
  "version": "1.0",
  "description": "A basic Chrome extension to measure circadian light.",


  
  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
  "scripting",
  "activeTab",
  "tabs"
],
  

  "icons": {
  "16": "icons/icon16.png",
  "32": "icons/icon32.png",
  "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  

},

"action": {
  "default_popup": "popup.html",
  "default_icon": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png"
  }
}

}
