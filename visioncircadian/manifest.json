{
  "manifest_version": 3,
  "name": "VisionCircadian",
  "version": "1.0",
  "description": "A basic Chrome extension to measure circadian light.",

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"]
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "permissions": ["activeTab"]
}
